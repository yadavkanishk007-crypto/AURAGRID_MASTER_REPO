# pyenv
#   For a library or app, you might want to share your .python-version.
#   Comment/uncomment the following line as needed.
#.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if used with a virtualenv, it may not be desired.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is recommended to include poetry.lock in version control.
#   poetry.lock

# pdm
#   Similar to Pipfile.lock, it is recommended to include pdm.lock in version control.
#pdm.lock
#   pdm persistent configuration file
.pdm-python.path
.pdm-build/

# PEP 582; dependency directory created by pipflow via pdm
__pypackages__/

